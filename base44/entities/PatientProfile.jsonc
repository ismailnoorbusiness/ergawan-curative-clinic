{
  "name": "PatientProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "fa",
        "ps"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink"
      ]
    },
    "contact_preference": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "whatsapp"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ]
    }
  },
  "required": [
    "user_id",
    "full_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}